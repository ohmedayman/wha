{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/portal",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    }
  ]
}